PORT=3008
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY=7d

# Railway/Postgres URL (preferred in deployment)
DATABASE_URL=
DATABASE_PUBLIC_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db
DB_SSL=false

PUBLIC_CLIENT_URL=http://localhost:3000

# Optional email service
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Optional S3-compatible storage (images)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_ENDPOINT=
AWS_PUBLIC_URL_BASE=
