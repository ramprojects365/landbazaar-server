  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
              "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postmanuser\",\n  \"email\": \"postman.user@example.com\",\n  \"phone_number\": \"+919900001111\",\n  \"password\": \"ram123\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
              "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"landowner.hyd@example.com\",\n  \"password\": \"ram123\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const response = pm.response.json();",
                    "if (response?.data?.token) {",
                    "  pm.environment.set('token', response.data.token);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
              "url": "{{baseUrl}}/auth/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"otp\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "Create Land Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
              "url": "{{baseUrl}}/properties",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingType\": \"sale\",\n  \"propertyType\": \"HMDA Approved Plot\",\n  \"title\": \"Postman Test Land Plot\",\n  \"description\": \"Created from Postman flow validation\",\n  \"price\": 1750000,\n  \"areaUnit\": \"Square Yard\",\n  \"landSize\": 150,\n  \"pricePerUnit\": 11666,\n  \"totalPrice\": 1750000,\n  \"cityName\": \"Hyderabad\",\n  \"state\": \"Telangana\",\n  \"pincode\": \"500072\",\n  \"location\": \"Kukatpally, Hyderabad\",\n  \"facingDirection\": \"North\",\n  \"cornerPlot\": \"Yes\",\n  \"roadWidth\": \"30 ft\",\n  \"surveyNumber\": \"88/A\",\n  \"approvalTypes\": [\"HMDA\"],\n  \"clearTitle\": \"Yes\",\n  \"registrationReady\": \"Yes\",\n  \"contactPersonName\": \"Postman User\",\n  \"contactNumber\": \"+919900001111\",\n  \"amenities\": {\n    \"lifestyle\": [],\n    \"facilities\": [\"CC Road\", \"Street Lights\"],\n    \"security\": []\n  }\n}"
            }
          }
        },
        {
          "name": "List Properties",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
              "url": "{{baseUrl}}/properties?listingType=sale&propertyType=HMDA%20Approved%20Plot&cityName=Hyderabad"
          }
        },
        {
          "name": "Search Properties",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
              "url": "{{baseUrl}}/properties/search?q=plot&city=Hyderabad&propertyType=HMDA%20Approved%20Plot"
          }
        },
        {
          "name": "Get Property By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
              "url": "{{baseUrl}}/properties/{{propertyId}}"
          }
        },
        {
          "name": "My Properties",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
              "url": "{{baseUrl}}/properties/my-properties"
          }
